[Unit]
Description=TonyPi agent (terminal + "hey Tony" voice commands -> Gemini 4 / local LFM3 fallback speech, and motion via tonyd)
After=tonypi-tonyd.service tonypi-llm.service sound.target
Wants=tonypi-tonyd.service tonypi-llm.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=pi
# /run/tonypi/agent.sock is how tonypi-chat talks to it
RuntimeDirectory=tonypi
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1 TONYPI_BRAIN_PROVIDER=auto TONYPI_VISION_PROVIDER=auto
# Optional Gemini credentials: when GEMINI_API_KEY is set, uses Gemini 4 Hydrogen brain +
# Gemini Robotics ER 2 vision automatically; falls back cleanly to local LFM3 / Piper offline
EnvironmentFile=-/etc/tonypi/gemini.env
ExecStart=/home/pi/tonypi/.venv/bin/tonypi-agent
Restart=on-failure
# voice front end: keep it over dev jobs and the LLM
OOMScoreAdjust=-500
RestartSec=5

[Install]
WantedBy=multi-user.target
