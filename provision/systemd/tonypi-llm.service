[Unit]
Description=TonyPi local LLM (llama-server, LFM2.5-1.2B-Instruct, OpenAI-compatible on :8080)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=pi
# LFM2 is hybrid (conv+attn): the prompt cache only resumes from a checkpoint saved at (prompt_len - ubatch),
# so a small -ub lets the long system prompt be reused (~1 s per command instead of ~8 s)
ExecStart=/usr/local/bin/llama-server -m /home/pi/models/LFM2.5-1.2B-Instruct-Q4_K_M.gguf --jinja -t 3 -c 8192 -np 2 -ub 64 -cms 64 \
  --host 127.0.0.1 --port 8080 --alias lfm2.5-1.2b --temp 0.1 --top-k 50 --repeat-penalty 1.05
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
