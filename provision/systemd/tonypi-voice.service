[Unit]
Description=TonyPi voice (GPT-Live-1 via Codex realtime, local wake word fallback; socket /run/tonypi/voice.sock)
After=network-online.target tonypi-tonyd.service
# owns the USB mic and speaker, like tonypi-agent: only one of them runs (a harness slot starts this one)
Conflicts=tonypi-agent.service

[Service]
User=pi
RuntimeDirectory=tonypi
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/run/tonypi/voice.env
ExecStart=/home/pi/tonypi/.venv/bin/tonypi-voice
Restart=on-failure
RestartSec=5
OOMScoreAdjust=-500
